# ---- Database ----
# Local dev uses the docker-compose Postgres instance (port 5433 on host).
DATABASE_URL="postgresql://evilwords:evilwords@127.0.0.1:5433/evilwords?schema=public"

# ---- Auth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ---- Free dictionary API (no key required) ----
# Youdao jsonapi is used directly; no key needed for MVP.
NEXT_PUBLIC_APP_NAME="Evil Words"
