    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@tanstack/react-query": "^5.51.0",
    "bcryptjs": "^2.4.3",
    "next": "16.2.12",
    "next-auth": "^4.24.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "better-sqlite3": "^13.0.3",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.39",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
